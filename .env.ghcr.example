WEBBBS_IMAGE=ghcr.io/paulkakell/webbbs:00.04.00
BIND_ADDRESS=127.0.0.1
PORT=3000
DB_VOLUME=./.data/postgres
APP_VOLUME=./.data/files

# Required. Generate two different values with: openssl rand -hex 24
POSTGRES_PASSWORD=
SYSOP_HANDLE=sysop
SYSOP_PASSWORD=
SESSION_TTL_DAYS=7
ALLOW_REGISTRATION=true
