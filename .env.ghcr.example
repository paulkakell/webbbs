# Copy to .env. Generate each password separately: openssl rand -hex 24
# Use hexadecimal POSTGRES_PASSWORD to avoid URL-encoding ambiguity.
POSTGRES_PASSWORD=
SYSOP_PASSWORD=
SYSOP_HANDLE=sysop
WEBBBS_IMAGE=ghcr.io/paulkakell/webbbs:00.03.03
BIND_ADDRESS=127.0.0.1
PORT=3000
DB_VOLUME=./.data/postgres
APP_VOLUME=./.data/files
SESSION_TTL_DAYS=7
ALLOW_REGISTRATION=true
