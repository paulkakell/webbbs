# Copy to .env for local dev. Docker Compose sets these automatically.

# Postgres connection string
DATABASE_URL="postgresql://bbs:bbs@localhost:5432/bbs?schema=public"

# HTTP port
PORT=3000

# Directory for uploaded files (inside container)
DATA_DIR=./data

# Bootstrap sysop account (created/updated on startup if missing)
SYSOP_HANDLE=sysop
SYSOP_PASSWORD=change-me

# Web admin session
SESSION_TTL_DAYS=7

# Optional: allow self-registration via BBS login screen
ALLOW_REGISTRATION=true
