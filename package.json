    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.3",
    "fastify": "^5.7.0",
    "mime-types": "^3.0.2",
    "pg": "^8.12.0",
    "uuid": "^14.0.2",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prisma": "^5.21.1"
